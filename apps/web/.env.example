# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://sarpech.in

# Admin sign-in (/admin). Required in production — without them admin login is disabled.
ADMIN_EMAIL=owner@sarpech.in
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# 32+ random characters, e.g. `openssl rand -base64 48`
ADMIN_SECRET=

# Proxies in front of the app that append to X-Forwarded-For (used to find the
# client IP for sign-in throttling). 1 suits Fly, Render, Railway or one nginx.
# TRUST_PROXY_HOPS=1

# Where the SQLite database and uploaded images live (default: ./storage)
# SARPECH_DATA_DIR=/var/lib/sarpech

# ── Email (Resend: https://resend.com) ──────────────────────────────────────
# Without these, emails (welcome, password reset, order confirmation, shipping
# updates) are printed to the server log instead of being sent.
# MAIL_FROM must use a domain you have verified in Resend.
RESEND_API_KEY=
MAIL_FROM="SARPECH <orders@sarpech.in>"
# Optional: where customer replies go
# MAIL_REPLY_TO=care@sarpech.in

# ── Payments (Razorpay: https://dashboard.razorpay.com/app/keys) ────────────
# Without the two keys, checkout takes the order without payment.
# Use test keys (rzp_test_…) until you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → https://<your-domain>/api/razorpay/webhook,
# events payment.captured + order.paid, with this secret:
RAZORPAY_WEBHOOK_SECRET=
