{
  "expo": {
    "name": "SARPECH",
    "slug": "sarpech",
    "scheme": "sarpech",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.sarpech.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SARPECH uses your camera for the Royal Fit body measurement. The video never leaves your phone."
      },
      "requireFullScreen": true
    },
    "android": {
      "package": "in.sarpech.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E1A15",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1A15",
          "image": "./assets/splash-icon.png",
          "imageWidth": 170
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "SARPECH uses your camera for the Royal Fit body measurement. The video never leaves your phone.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
