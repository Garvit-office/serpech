# Copy to .env.local. Where the app finds the SARPECH server (apps/web).
# Simulator/emulator: http://localhost:3000 (Android: `adb reverse tcp:3000 tcp:3000`).
# Real phone: an https URL (the camera Fit Check needs a secure origin), e.g. a tunnel.
# Release builds take this from eas.json instead.
EXPO_PUBLIC_API_URL=http://localhost:3000
